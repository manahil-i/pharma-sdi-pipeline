    {
      "id": 6,
      "type": "barchart",
      "title": "Rows per table (latest)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT table_name, row_count AS rows FROM monitoring.storage_log\nWHERE captured_at = (SELECT MAX(captured_at) FROM monitoring.storage_log) AND row_count IS NOT NULL AND layer <> 'monitoring (PostgreSQL)' ORDER BY row_count DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Size by layer and domain (MB)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source_domain, SUM(CASE WHEN layer = 'staging (PostgreSQL)' THEN size_mb END) AS \"staging MB\",\n       SUM(CASE WHEN layer = 'mart (DuckDB)' THEN size_mb END) AS \"mart MB\"\nFROM monitoring.storage_log WHERE captured_at = (SELECT MAX(captured_at) FROM monitoring.storage_log) AND table_name NOT LIKE '\\_whole%' AND source_domain <> 'Monitoring'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
