          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source_domain, SUM(CASE WHEN layer = 'staging (PostgreSQL)' THEN size_mb END) AS \"staging MB\",\n       SUM(CASE WHEN layer = 'mart (DuckDB)' THEN size_mb END) AS \"mart MB\"\nFROM monitoring.storage_log WHERE captured_at = (SELECT MAX(captured_at) FROM monitoring.storage_log) AND table_name NOT LIKE '\\_whole%' AND source_domain <> 'Monitoring'\nGROUP BY 1 ORDER BY 1",
