          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT layer, table_name, source_domain, row_count, size_mb, min_date AS first_date, max_date AS last_date\nFROM monitoring.storage_log WHERE captured_at = (SELECT MAX(captured_at) FROM monitoring.storage_log) ORDER BY layer, row_count DESC NULLS LAST"
