          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT left(replace(query_name, 'Live: ', ''), 45) || ' #' || log_id AS query, duration_ms AS ms\nFROM (SELECT * FROM monitoring.query_log WHERE variant = 'live' AND $__timeFilter(started_at)\n      ORDER BY log_id DESC LIMIT 15) x ORDER BY log_id"
        }
