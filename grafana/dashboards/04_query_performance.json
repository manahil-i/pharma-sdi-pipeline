    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Pipeline queries: median time per query \u2013 last run (ms)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT split_part(query_name, ' ', 1) AS query,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant = 'raw')     AS raw,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant = 'summary') AS summary\nFROM monitoring.query_log WHERE run_id = (SELECT run_id FROM monitoring.query_log WHERE variant <> 'live' ORDER BY log_id DESC LIMIT 1) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
