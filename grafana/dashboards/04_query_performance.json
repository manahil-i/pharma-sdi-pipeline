          "rawSql": "SELECT to_char(date_trunc('day', started_at), 'YYYY-MM-DD') AS day,\n       COUNT(*) FILTER (WHERE variant = 'live') AS live,\n       COUNT(*) FILTER (WHERE variant <> 'live') AS pipeline,\n       COUNT(*) FILTER (WHERE status = 'failed') AS failed\nFROM monitoring.query_log WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1"
