    {
      "id": 11,
      "type": "timeseries",
      "title": "Execution time of every query (ms)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT started_at AS time,\n       CASE WHEN variant = 'live' THEN 'live queries' ELSE split_part(query_name, ' ', 1) || ' ' || variant END AS metric,\n       duration_ms AS value\nFROM monitoring.query_log WHERE $__timeFilter(started_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
