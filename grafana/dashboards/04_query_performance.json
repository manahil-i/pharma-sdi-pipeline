        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) FROM monitoring.query_log WHERE status = 'failed' AND $__timeFilter(started_at)"
