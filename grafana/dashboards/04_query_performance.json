    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Pipeline queries: speed-up from summary tables (x times faster)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT split_part(query_name, ' ', 1) AS query,\n       ROUND((percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant = 'raw') /\n        NULLIF(percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant = 'summary'), 0))::numeric, 1) AS \"speed-up\"\nFROM monitoring.query_log WHERE run_id = (SELECT run_id FROM monitoring.query_log WHERE variant <> 'live' ORDER BY log_id DESC LIMIT 1) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Query run details (grouped)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT run_id, CASE WHEN variant = 'live' THEN 'live' ELSE 'pipeline ' || variant END AS type, query_name, COUNT(*) AS runs, ROUND(AVG(duration_ms),2) AS avg_ms,\n       ROUND(MIN(duration_ms),2) AS min_ms, ROUND(MAX(duration_ms),2) AS max_ms, MAX(rows_returned) AS rows_returned,\n       MIN(status) AS status, MAX(error_message) AS error_message, MAX(started_at) AS last_run\nFROM monitoring.query_log WHERE $__timeFilter(started_at) GROUP BY 1,2,3 ORDER BY last_run DESC, query_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
