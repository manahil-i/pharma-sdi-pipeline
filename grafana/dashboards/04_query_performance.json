            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FROM monitoring.query_log WHERE run_id = (SELECT run_id FROM monitoring.query_log ORDER BY log_id DESC LIMIT 1) AND variant = 'raw'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
