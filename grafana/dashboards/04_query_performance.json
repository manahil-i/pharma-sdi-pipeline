      "type": "barchart",
      "title": "Queries per day (all) \u2013 with failures",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 9,
