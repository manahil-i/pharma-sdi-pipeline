{
  "uid": "sdi-query",
  "title": "SDI 4 - Query Performance",
  "description": "Execution time of the analytical queries - raw star join vs summary table",
  "tags": [
    "sdi",
    "milestone1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
