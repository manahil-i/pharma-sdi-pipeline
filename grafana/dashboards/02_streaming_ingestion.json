          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT batch_id, file_name, COUNT(*) AS micro_batches, SUM(events_received) AS events, SUM(events_loaded) AS loaded,\n       SUM(malformed_count) AS malformed, ROUND(AVG(latency_sec),3) AS avg_latency_s, ROUND(AVG(throughput_eps)) AS avg_eps,\n       MIN(emitted_at) AS started, MAX(inserted_at) AS finished\nFROM monitoring.stream_ingestion_log WHERE $__timeFilter(emitted_at) GROUP BY 1, 2 ORDER BY 1 DESC",
          "refId": "A"
        }
      ],
