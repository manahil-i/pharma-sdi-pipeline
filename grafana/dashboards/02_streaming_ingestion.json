            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT inserted_at AS time, 'events received' AS metric, events_received AS value FROM monitoring.stream_ingestion_log WHERE $__timeFilter(emitted_at)\nUNION ALL SELECT inserted_at, 'events loaded', events_loaded FROM monitoring.stream_ingestion_log WHERE $__timeFilter(emitted_at)\nORDER BY 1"
