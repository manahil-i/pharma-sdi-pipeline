      "options": {
        "mode": "markdown",
        "content": "**Streaming ingestion** \u2013 refresh sales files are fed in micro-batches of 500 events. Latency = inserted_at \u2212 emitted_at, throughput = events \u00f7 seconds, malformed = rows with a missing key or bad date (dropped)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events received",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(events_received),0) FROM monitoring.stream_ingestion_log WHERE $__timeFilter(emitted_at)"
