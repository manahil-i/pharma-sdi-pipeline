      "type": "barchart",
      "title": "Data-quality: rows rejected per rule",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
