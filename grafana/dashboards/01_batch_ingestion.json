          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT batch_id::text || ' ' || split_part(file_name, '.', 1) AS batch, rows_read AS \"rows processed\"\nFROM monitoring.batch_ingestion_log WHERE $__timeFilter(started_at) ORDER BY log_id"
        }
