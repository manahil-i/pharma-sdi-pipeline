    {
      "id": 6,
      "type": "barchart",
      "title": "Rows processed per batch",
      "description": "One bar per loaded file",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
