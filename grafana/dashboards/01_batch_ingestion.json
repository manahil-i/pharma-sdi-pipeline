      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT staging_table || ' \u00b7 ' || rule_name AS rule, SUM(failed_rows) AS \"rejected rows\"\nFROM monitoring.dq_log WHERE $__timeFilter(checked_at) AND failed_rows > 0 GROUP BY 1 ORDER BY 2 DESC"
