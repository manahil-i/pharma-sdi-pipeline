      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'stg_pharmacy_sales' AS staging_table, dq_status, COUNT(*) AS rows FROM staging.stg_pharmacy_sales GROUP BY 2\nUNION ALL SELECT 'stg_hospital_demand', dq_status, COUNT(*) FROM staging.stg_hospital_demand GROUP BY 2\nUNION ALL SELECT 'stg_master_data', dq_status, COUNT(*) FROM staging.stg_master_data GROUP BY 2\nUNION ALL SELECT 'stg_warehouse_data', dq_status, COUNT(*) FROM staging.stg_warehouse_data GROUP BY 2\nORDER BY 1, 2"
        }
